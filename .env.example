# Refectorio — пример переменных окружения.
# Скопируйте в .env.local и заполните. Настоящие значения НИКОГДА не коммитьте:
# на хостинге они задаются в настройках Render и GitHub (Secrets).

# --- Этапы 0–1 (статический сайт) ---
# База путей сборки: "/" для Render (по умолчанию), "/refectorio/" для GitHub Pages (задаёт workflow pages.yml).
# VITE_BASE=/

# --- Этапы 2–3 (сервер API на Render Web Service; только в настройках Render) ---
# NVIDIA_NIM_API_KEY=
# OPENROUTER_API_KEY=
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
