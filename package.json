{
  "name": "refectorio",
  "version": "0.1.0",
  "private": true,
  "description": "Refectorio — сайт-постановщик целей в питании с ИИ. Школьный проект команды Modern Manifesto (школа #2107).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev -w @refectorio/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @refectorio/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @refectorio/web --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/optimize-assets.mjs",
    "lhci": "lhci autorun",
    "prepare": "husky",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "icons": "node scripts/make-icons.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "compare-design": "node scripts/compare-with-design.mjs",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/open-runde": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
