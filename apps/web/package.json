{
  "name": "@refectorio/web",
  "version": "0.1.0",
  "private": true,
  "description": "Refectorio — сайт (главная страница и будущие разделы).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/photos/materialize.mjs --quick",
    "dev": "vite",
    "prebuild": "node ../../scripts/photos/materialize.mjs",
    "build": "vite build",
    "prebuild:test": "node ../../scripts/photos/materialize.mjs",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:test": "vite preview --port 4173 --strictPort --outDir dist-test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@refectorio/contracts": "*",
    "@refectorio/nutrition-core": "*",
    "@refectorio/taste-core": "*",
    "@tabler/icons-react": "^3.48.0",
    "blurhash": "2.0.5",
    "clsx": "^2.1.1",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
