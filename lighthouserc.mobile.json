{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/web/dist",
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["is-on-https"],
        "blockedUrlPatterns": ["*kaspersky-labs.com*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci/mobile"
    }
  }
}
